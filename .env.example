# =============================================================================
# Brief — Self-Hosted Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env

# Application
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# Security (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-secure-random-string

# Database
# By default, Brief uses zero-config SQLite stored in BRIEF_DATA_DIR/brief.db.
# To use PostgreSQL instead, uncomment DATABASE_URL and start with `--profile postgres`:
# DATABASE_URL=postgresql://brief:change-me-db-password@postgres:5432/brief
POSTGRES_USER=brief
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=brief

# Optional: Image tag for docker-compose.yml (e.g., latest, develop, v0.1.0)
BRIEF_VERSION=latest

# Optional: Static API token for Agent Read/Write API & MCP (/api/mcp, /api/v1/*)
# Additional tokens can also be generated in the Brief UI (Agent MCP & API).
BRIEF_API_TOKEN=

# Optional: Directory for persisted workspace & token data (default: ./.brief-data)
BRIEF_DATA_DIR=
